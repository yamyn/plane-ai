{
	"info": {
		"_postman_id": "plane-api-collection",
		"name": "Plane API",
		"description": "Plane API Collection with API Key authentication.\n\nVariables:\n- `base_url`: Your Plane API server URL (e.g., https://api.plane.so)\n- `api_key`: Your API key from Plane workspace settings",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "x-api-key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{api_key}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "your-api-key-here",
			"type": "string"
		},
		{
			"key": "workspace_slug",
			"value": "my-workspace",
			"type": "string"
		},
		{
			"key": "project_id",
			"value": "00000000-0000-0000-0000-000000000000",
			"type": "string"
		}
	],
